#!/usr/bin/env bash
# Termux-Pro managed command.
set -Eeuo pipefail

usage() {
    cat <<'HELP'
Termux-Pro | development tools for Termux

Usage: tp [help|health|config|update|uninstall]
  health   Check dependencies, installed commands and repository registration.
  config   Display installation paths without reading credentials.
  update   Fast-forward the clean tracked checkout and refresh commands.
  uninstall Remove unchanged managed files; preserve your checkout and packages.

Shortcuts: tp-health, tp-config, tp-update, tp-uninstall
HELP
}

fail() { printf '[TP] ERROR: %s\n' "$*" >&2; exit 1; }
require_environment() {
    [[ -n ${HOME:-} && $HOME == /* && -n ${PREFIX:-} && $PREFIX == /* ]] ||
        fail 'Run this command in Termux with HOME and PREFIX set.'
}
load_repository() {
    local record="$HOME/.config/termux-pro/repository"
    if [[ ! -r $record ]] || ! IFS= read -r repository < "$record"; then
        printf '[TP] ERROR: Missing repository registration; rerun bash install.sh.\n' >&2
        return 1
    fi
    if [[ $repository != /* || ! -f $repository/install.sh ]]; then
        printf '[TP] ERROR: Registered checkout is unavailable; reinstall from its current path.\n' >&2
        return 1
    fi
}
health() {
    local failures=0 name
    for name in bash git curl wget nvim; do
        if command -v "$name" >/dev/null 2>&1; then
            printf '[OK] dependency: %s\n' "$name"
        else
            printf '[FAIL] missing dependency: %s\n' "$name"
            failures=$((failures + 1))
        fi
    done
    for name in termux-pro tp tp-health tp-config tp-update tp-uninstall; do
        if [[ -x $PREFIX/bin/$name ]]; then
            printf '[OK] command: %s\n' "$name"
        else
            printf '[FAIL] missing installed command: %s\n' "$name"
            failures=$((failures + 1))
        fi
    done
    if (
        # shellcheck source=lib/lifecycle.sh
        source "$PREFIX/lib/termux-pro/lifecycle.sh" || exit 1
        tp_paths
        tp_check_ownership uninstall
    ); then
        printf '[OK] managed file integrity\n'
    else
        printf '[FAIL] installation receipt or managed file integrity\n'
        failures=$((failures + 1))
    fi
    if load_repository; then
        printf '[OK] checkout: %s\n' "$repository"
    else
        failures=$((failures + 1))
    fi
    if ((failures)); then
        printf '[TP] Health check failed: %s problem(s).\n' "$failures" >&2
        return 1
    fi
    printf '[TP] Health check passed.\n'
}
config() {
    load_repository || return 1
    printf 'Repository: %s\nCommands: %s/bin\nRegistration: %s/.config/termux-pro/repository\n' \
        "$repository" "$PREFIX" "$HOME"
}
update() {
    load_repository || return 1
    command -v git >/dev/null 2>&1 || fail 'Git is missing; rerun bash install.sh.'
    local top branch changes
    top=$(git -C "$repository" rev-parse --show-toplevel) || fail 'The checkout is not a Git repository.'
    [[ $top == "$repository" ]] || fail 'The registered directory must be the repository root.'
    branch=$(git -C "$repository" symbolic-ref --quiet --short HEAD) || fail 'Checkout is detached; switch to a tracked branch first.'
    changes=$(git -C "$repository" status --porcelain --untracked-files=all)
    [[ -z $changes ]] || fail 'Checkout has local changes or untracked files. Commit, move or stash them before updating.'
    git -C "$repository" rev-parse --verify '@{upstream}' >/dev/null 2>&1 ||
        fail "Branch $branch has no upstream; configure its tracking branch first."
    git -C "$repository" pull --ff-only
    "$PREFIX/bin/bash" "$repository/install.sh" --skip-packages
    printf '[TP] Update complete.\n'
}

command_name=${1:-help}
if (($#)); then shift; fi
(($# == 0)) || { usage >&2; exit 2; }
case "$command_name" in
    help|-h|--help) usage ;;
    health) require_environment; health ;;
    config) require_environment; config ;;
    update) require_environment; update ;;
    uninstall) require_environment; exec "$PREFIX/bin/tp-uninstall" ;;
    *) printf '[TP] Unknown command: %s\n' "$command_name" >&2; usage >&2; exit 2 ;;
esac
